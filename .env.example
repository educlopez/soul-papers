# Tally form embed (see src/components/consequence-nudge.tsx)
NEXT_PUBLIC_TALLY_URL=

# Tally API key (v2 ingestion agent — scripts/ingest-tally.ts). Get this from
# your Tally account settings (Settings > API). NEVER print or commit its value.
TALLY_API_KEY=

# Optional: override the Tally form the ingestion agent polls. Defaults to
# "ODyJrk" (the same form linked from NEXT_PUBLIC_TALLY_URL) when unset.
TALLY_FORM_ID=

# Upstash Redis REST credentials (warm per-letter read counter — src/app/api/letters/[slug]/route.ts)
# Get these from your Upstash console: https://console.upstash.com
# When unset, the counter route degrades silently to {count: null} — no crash, no blocking.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
