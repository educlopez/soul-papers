{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next",
    "ultracite/biome/vitest"
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["**/*", "!public"]
  },
  "overrides": [
    {
      "includes": ["__tests__/**", "scripts/**"],
      "linter": {
        "rules": {
          "performance": {
            "noAwaitInLoops": "off",
            "useTopLevelRegex": "off"
          },
          "suspicious": {
            "useAwait": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "actions": {
      "source": {
        "useSortedAttributes": "off",
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 35 }
        }
      },
      "performance": {
        "noJsxPropsBind": "off",
        "noNamespaceImport": "off"
      },
      "style": {
        "noIncrementDecrement": "off"
      },
      "suspicious": {
        "noUnnecessaryConditions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "tab",
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "cssModules": true,
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "indentStyle": "space",
      "indentWidth": 2
    }
  }
}
